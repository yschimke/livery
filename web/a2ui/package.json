{
  "name": "@yschimke/livery-a2ui",
  "version": "0.25.0",
  "description": "Livery contracts as A2UI components on the web: Livery's own selection, trust and binding (compiled to Wasm), drawn in the page by the TypeScript Remote Compose player with live named values",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yschimke/livery.git",
    "directory": "web/a2ui"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./livery-web/*": "./dist/livery-web/*",
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "default": "./dist/angular.js"
    },
    "./livery-web-compose/*": "./dist/livery-web-compose/*"
  },
  "files": [
    "dist",
    "vendor",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && ngc -p tsconfig.angular.json && node scripts/copy-livery-web.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node test/all.mjs",
    "pack:check": "node scripts/check-pack.mjs"
  },
  "dependencies": {
    "@a2ui/lit": "0.15.0",
    "@a2ui/web_core": "0.15.0",
    "@js-joda/core": "6.3.2",
    "lit": "3.3.3",
    "zod": "3.25.76",
    "@yschimke/livery-web": "file:../core"
  },
  "devDependencies": {
    "@a2ui/angular": "0.14.0",
    "@a2ui/react": "0.15.0",
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/compiler-cli": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "binaryen": "132.0.0",
    "esbuild": "0.28.2",
    "playwright": "1.65.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rxjs": "7.8.2",
    "tslib": "2.9.1",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@a2ui/angular": "0.14.0",
    "@a2ui/react": "0.15.0",
    "@angular/common": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "peerDependenciesMeta": {
    "@a2ui/angular": {
      "optional": true
    },
    "@a2ui/react": {
      "optional": true
    },
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@angular/platform-browser": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "bundleDependencies": [
    "@yschimke/livery-web"
  ]
}
