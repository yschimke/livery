{
  "id": "shop/quantity", "major": 1, "title": "Quantity stepper", "dataSource": "App",
  "inputs": {
    "name": { "type": "string", "required": true, "maxLength": 40 },
    "price": { "type": "string", "maxLength": 16, "description": "formatted for display: \"€2.49\"" },
    "quantity": { "type": "int", "min": 0, "max": 9, "default": 1 },
    "theme.primary": { "type": "color", "role": "primary" },
    "theme.surface": { "type": "color", "role": "surface" },
    "theme.onSurface": { "type": "color", "role": "onSurface" }
  },
  "actions": {
    "setQuantity": { "kind": "set", "input": "quantity", "description": "the person stepped the quantity; the host writes it back" }
  },
  "examples": {
    "one": { "name": "Oat milk, 1 l", "price": "€2.49", "quantity": 1 },
    "none": { "name": "Oat milk, 1 l", "price": "€2.49", "quantity": 0 }
  }
}
