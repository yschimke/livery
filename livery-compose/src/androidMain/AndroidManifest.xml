<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <application>
    <!--
      Compose's text depends on androidx.emoji2, whose EmojiCompatInitializer androidx.startup runs
      at process start: on the main thread, before the first frame, it looks up the downloadable
      emoji font's provider through the package manager and schedules the font's load. An app that
      plays Livery templates pays for that on every cold start, whether or not it shows an emoji.

      So Livery takes it out of the merged manifest, and the app loads emoji when it chooses, off
      the main thread: `LiveryEmoji.load(context)`, typically once the first screen is ready
      (`LiveryStartup`). Until then text draws with the platform's own emoji. An app that wants the
      initializer back declares this same <meta-data> in its own manifest with tools:node="replace".
    -->
    <provider
      android:name="androidx.startup.InitializationProvider"
      android:authorities="${applicationId}.androidx-startup"
      android:exported="false"
      tools:node="merge">
      <meta-data
        android:name="androidx.emoji2.text.EmojiCompatInitializer"
        tools:node="remove" />
    </provider>
  </application>
</manifest>
