<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <!-- Lets the generator's Macrobenchmark read the app's profile without root. -->
  <application
    android:label="Livery profile host"
    android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
    <profileable android:shell="true" />
    <activity
      android:name=".CatalogActivity"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <!-- The feed :livery-benchmark flings, as Livery templates or as Compose UI (extra "mode"). -->
    <activity
      android:name=".FeedActivity"
      android:exported="true" />
    <!-- One template filling the screen, for DocumentBenchmark (extra "lane"). -->
    <activity
      android:name=".DocumentActivity"
      android:exported="true" />

    <!--
      No emoji initializer at process start, in every lane: Livery's own manifest removes androidx
      emoji2's EmojiCompatInitializer from any app that uses it (livery-compose's AndroidManifest.xml),
      so this host needs no entry of its own. A copy here also failed lint (MissingClass), since the
      host does not compile against androidx.startup itself. Before it was removed, the initializer
      loaded the emoji font ~450 ms after the first frame and re-measured all text, in every lane
      (the Compose UI twin included): ~690 ms to full display for that alone.
    -->
  </application>
</manifest>
