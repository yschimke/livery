<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <!-- Lets the generator's Macrobenchmark read the app's profile without root. -->
  <application
    android:label="Livery profile host"
    android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
    <profileable android:shell="true" />
    <activity
      android:name=".CatalogActivity"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <!-- The feed :livery-benchmark flings, as Livery templates or as Compose UI (extra "mode"). -->
    <activity
      android:name=".FeedActivity"
      android:exported="true" />
    <!-- One template filling the screen, for DocumentBenchmark (extra "lane"). -->
    <activity
      android:name=".DocumentActivity"
      android:exported="true" />

    <!--
      No emoji font loading in the benchmark host. AndroidX Compose's text stack depends on emoji2,
      whose startup initializer asks a font provider for the emoji font ~450 ms after the first frame
      and then makes Compose text re-measure and draw a frame. Nothing here draws emoji, the cost is
      the same for every lane, and it lands in the middle of what we measure: StartupTimingMetric ends
      "full display" at the first frame after reportFullyDrawn, so a settled screen measured ~690 ms in
      every lane (the Compose UI twin included) when the document was drawn by ~150 ms; and a fling or
      a data change picks up a stray re-layout. Real apps keep the initializer; its cost is not
      Livery's. Removing its androidx.startup entry is the standard way to opt out.
      DocumentActivity requests a frame after reportFullyDrawn, since nothing else will draw one now.
      The provider is only here to carry the removal into the merge: androidx.startup arrives through
      Compose's emoji2, not as a dependency of this module, so lint cannot see the class (MissingClass).
      The merged manifest keeps the other initializers and drops this one.
    -->
    <provider
      android:name="androidx.startup.InitializationProvider"
      android:authorities="${applicationId}.androidx-startup"
      android:exported="false"
      tools:node="merge"
      tools:ignore="MissingClass">
      <meta-data
        android:name="androidx.emoji2.text.EmojiCompatInitializer"
        tools:node="remove" />
    </provider>
  </application>
</manifest>
