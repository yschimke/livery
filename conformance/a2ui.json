{
  "note": "Livery in A2UI's terms (docs/A2UI.md): the component each contract becomes, and the data and events that cross between A2UI and Livery.",
  "components": [
    {
      "contract": {
        "id": "promo/banner",
        "major": 1,
        "title": "Promotion banner",
        "inputs": {
          "headline": {
            "type": "string",
            "required": true,
            "maxLength": 40
          },
          "body": {
            "type": "string",
            "maxLength": 120
          },
          "cta": {
            "type": "string",
            "required": true,
            "maxLength": 18
          },
          "hero": {
            "type": "image"
          },
          "accent": {
            "type": "color",
            "default": "#FF6750A4"
          },
          "theme.primary": {
            "type": "color",
            "role": "primary"
          },
          "theme.surface": {
            "type": "color",
            "role": "surface"
          },
          "theme.onSurface": {
            "type": "color",
            "role": "onSurface"
          }
        },
        "actions": {
          "cta": {
            "kind": "navigate",
            "args": {
              "route": {
                "type": "string",
                "required": true
              }
            }
          },
          "dismiss": {
            "kind": "dismiss"
          }
        },
        "examples": {
          "default": {
            "headline": "Try Premium free",
            "body": "Offline downloads and no ads for 30 days.",
            "cta": "Start trial"
          },
          "long": {
            "headline": "A headline that uses all forty character",
            "body": "Body copy at its limit to check wrapping on the smallest supported width.",
            "cta": "Eighteen chars cta"
          }
        },
        "dataSource": "Decision"
      },
      "name": "PromoBanner",
      "schema": {
        "type": "object",
        "properties": {
          "component": {
            "type": "string",
            "const": "PromoBanner"
          },
          "headline": {
            "$ref": "common_types.json#/$defs/DynamicString",
            "description": "At most 40 characters."
          },
          "body": {
            "$ref": "common_types.json#/$defs/DynamicString",
            "description": "At most 120 characters."
          },
          "cta": {
            "$ref": "common_types.json#/$defs/DynamicString",
            "description": "At most 18 characters."
          },
          "hero": {
            "$ref": "common_types.json#/$defs/DynamicString",
            "description": "An image: asset:<sha256>, https://… or app:<key>."
          },
          "accent": {
            "$ref": "common_types.json#/$defs/DynamicString",
            "description": "A colour, #RRGGBB or #AARRGGBB. Default \"#FF6750A4\"."
          },
          "design": {
            "type": "string",
            "description": "A Livery design id to prefer; unavailable falls back to the automatic choice."
          },
          "variant": {
            "type": "string",
            "description": "A layout variant to prefer, such as compact or hero."
          },
          "actions": {
            "type": "object",
            "properties": {
              "cta": {
                "$ref": "common_types.json#/$defs/Action",
                "description": "Kind navigate. Adds route to an event's context."
              },
              "dismiss": {
                "$ref": "common_types.json#/$defs/Action",
                "description": "Kind dismiss."
              }
            },
            "additionalProperties": false,
            "description": "What each of the template's actions does; an action left out is handled by the app."
          },
          "template": {
            "description": "Usually left out: the client picks a reviewed design. {\"query\": {...}} asks the app server; {\"sha256\": <hash>, \"url\"?: <https>, \"signature\"?: {...}} names an exact document. To send bytes: {\"inline\": <base64 Remote Compose bytes>, \"signature\": {\"keyId\", \"signature\"}}; unsigned bytes play only where the app allows them, and never with shaders or other risky features."
          }
        },
        "required": [
          "component",
          "headline",
          "cta"
        ],
        "description": "Promotion banner. Livery contract promo/banner@1: a server-driven template; its look is chosen by the client."
      }
    },
    {
      "contract": {
        "id": "social/poll",
        "major": 1,
        "title": "Poll",
        "inputs": {
          "question": {
            "type": "string",
            "required": true,
            "maxLength": 120
          },
          "summary": {
            "type": "string",
            "maxLength": 48,
            "description": "under the options, formatted for display: \"128 votes · closes Friday\""
          },
          "theme.primary": {
            "type": "color",
            "role": "primary"
          },
          "theme.surface": {
            "type": "color",
            "role": "surface"
          },
          "theme.onSurface": {
            "type": "color",
            "role": "onSurface"
          }
        },
        "lists": {
          "options": {
            "item": {
              "label": {
                "type": "string",
                "required": true,
                "maxLength": 40
              },
              "share": {
                "type": "float",
                "default": 0,
                "min": 0.0,
                "max": 1.0,
                "description": "this option's fraction of the votes, drawn as its bar"
              },
              "result": {
                "type": "string",
                "maxLength": 8,
                "description": "the share formatted for display: \"42%\""
              },
              "mark": {
                "type": "string",
                "maxLength": 2,
                "description": "\"✓\" on the option the person chose, otherwise empty"
              }
            },
            "max": 4
          }
        },
        "actions": {
          "vote": {
            "kind": "app:vote",
            "args": {
              "option": {
                "type": "string",
                "required": true,
                "description": "the chosen option's index, from 0"
              }
            },
            "description": "the person picked an option"
          }
        },
        "examples": {
          "open": {
            "question": "Which language do you write your UI in?",
            "summary": "128 votes",
            "options": [
              {
                "label": "Kotlin",
                "share": 0.52,
                "result": "52%"
              },
              {
                "label": "Swift",
                "share": 0.27,
                "result": "27%"
              },
              {
                "label": "TypeScript",
                "share": 0.21,
                "result": "21%"
              }
            ]
          },
          "voted": {
            "question": "Which language do you write your UI in?",
            "summary": "129 votes · you voted",
            "options": [
              {
                "label": "Kotlin",
                "share": 0.53,
                "result": "53%",
                "mark": "✓"
              },
              {
                "label": "Swift",
                "share": 0.26,
                "result": "26%"
              },
              {
                "label": "TypeScript",
                "share": 0.21,
                "result": "21%"
              }
            ]
          }
        }
      },
      "name": "SocialPoll",
      "schema": {
        "type": "object",
        "properties": {
          "component": {
            "type": "string",
            "const": "SocialPoll"
          },
          "question": {
            "$ref": "common_types.json#/$defs/DynamicString",
            "description": "At most 120 characters."
          },
          "summary": {
            "$ref": "common_types.json#/$defs/DynamicString",
            "description": "under the options, formatted for display: \"128 votes · closes Friday\" At most 48 characters."
          },
          "options": {
            "$ref": "common_types.json#/$defs/DynamicValue",
            "description": "An array of at most 4 objects, each with label, share, result, mark."
          },
          "design": {
            "type": "string",
            "description": "A Livery design id to prefer; unavailable falls back to the automatic choice."
          },
          "variant": {
            "type": "string",
            "description": "A layout variant to prefer, such as compact or hero."
          },
          "actions": {
            "type": "object",
            "properties": {
              "vote": {
                "$ref": "common_types.json#/$defs/Action",
                "description": "the person picked an option Kind app:vote. Adds option to an event's context."
              }
            },
            "additionalProperties": false,
            "description": "What each of the template's actions does; an action left out is handled by the app."
          },
          "template": {
            "description": "Usually left out: the client picks a reviewed design. {\"query\": {...}} asks the app server; {\"sha256\": <hash>, \"url\"?: <https>, \"signature\"?: {...}} names an exact document. To send bytes: {\"inline\": <base64 Remote Compose bytes>, \"signature\": {\"keyId\", \"signature\"}}; unsigned bytes play only where the app allows them, and never with shaders or other risky features."
          }
        },
        "required": [
          "component",
          "question"
        ],
        "description": "Poll. Livery contract social/poll@1: a server-driven template; its look is chosen by the client."
      }
    },
