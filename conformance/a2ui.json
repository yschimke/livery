    {
      "name": "an argument wins over a context key it shadows, which is reported",
      "action": {
        "event": {
          "name": "vote",
          "context": {
            "option": "9",
            "poll": "p"
          }
        }
      },
      "args": {
        "option": "1"
      },
      "expect": {
        "action": {
          "event": {
            "name": "vote",
            "context": {
              "option": "1",
              "poll": "p"
            }
          }
        },
        "shadowed": [
          "option"
        ]
      }
    },
    {
      "name": "a function call passes as it is",
      "action": {
        "functionCall": {
          "call": "openUrl",
          "args": {
            "url": "https://example.com"
          }
        }
      },
      "args": {
        "route": "/x"
      },
      "expect": {
        "action": {
          "functionCall": {
            "call": "openUrl",
            "args": {
              "url": "https://example.com"
            }
          }
        },
        "shadowed": []
      }
    }
  ]
}
